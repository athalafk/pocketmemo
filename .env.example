# ============================================================
# PocketMemo — environment configuration
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# ============================================================

# ---- Telegram ----------------------------------------------
# Create a bot with @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=

# How the bot receives updates:
#   polling  — the bot pulls updates from Telegram. No public URL, domain, or TLS
#              needed. Easiest for self-hosting. (default, recommended)
#   webhook  — Telegram pushes updates to WEBHOOK_URL. Needs a public HTTPS
#              endpoint (reverse proxy + cert). Better for scale/production.
BOT_MODE=polling

# --- the two settings below are ONLY needed when BOT_MODE=webhook ---
# Public HTTPS URL where Telegram will send updates (must end with /webhook),
# e.g. https://bot.example.com/webhook
WEBHOOK_URL=

# Random secret that Telegram echoes back to verify requests.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Optional: key for encrypting secrets you set via the bot (e.g. API keys with
# /llm). Leave blank to derive one from WEBHOOK_SECRET. For a dedicated key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Language ----------------------------------------------
# Default output language for new users: "en" or "id".
DEFAULT_LANGUAGE=en

# ---- LLM ---------------------------------------------------
# Which LLM backend to use: "gemini", "openai", or "ollama".
# Fill in only the section for the provider you choose below.
# TIP: an admin can also set the provider, model, and API keys from the bot with
#      /llm (stored encrypted) — then you can leave the values below blank.
# IMPORTANT: the embedding model must output 768-dim vectors (to match the DB).
LLM_PROVIDER=gemini

# ---- Google Gemini  (LLM_PROVIDER=gemini) ------------------
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- OpenAI-compatible  (LLM_PROVIDER=openai) --------------
# Works with OpenAI, Groq, OpenRouter, Together, DeepSeek, Mistral, LM Studio,
# vLLM, and Ollama's /v1 endpoint. Just point the base URL at your provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Ollama (local)  (LLM_PROVIDER=ollama) -----------------
# Run models locally with Ollama (https://ollama.com). Use a vision model
# (e.g. llava) if you want image Q&A. nomic-embed-text is 768-dim.
# In Docker, point at the host: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Database (PostgreSQL + pgvector) ----------------------
# These are assembled into DATABASE_URL by docker-compose.
DB_USER=pocketmemo
DB_PASSWORD=change-me
DB_NAME=pocketmemo
DB_HOST=db
DB_PORT=5432

# ---- Application -------------------------------------------
APP_PORT=8473
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone who messages the bot.
# Find your ID with @userinfobot.
ALLOWED_USER_IDS=
