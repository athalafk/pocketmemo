# ============================================================
# PocketMemo — environment configuration
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# ============================================================

# ---- Telegram ----------------------------------------------
# Create a bot with @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=

# How the bot receives updates:
#   polling  — the bot pulls updates from Telegram. No public URL, domain, or TLS
#              needed. Easiest for self-hosting. (default, recommended)
#   webhook  — Telegram pushes updates to WEBHOOK_URL. Needs a public HTTPS
#              endpoint (reverse proxy + cert). Better for scale/production.
BOT_MODE=polling

# WEBHOOK_URL is only needed in webhook mode. WEBHOOK_SECRET is required in
# webhook mode and can also serve as encryption material in polling mode.
# Public HTTPS URL where Telegram will send updates (must end with /webhook),
# e.g. https://bot.example.com/webhook
WEBHOOK_URL=

# Random secret that Telegram echoes back to verify requests.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Key for encrypting secrets you set via the bot (e.g. API keys with /llm).
# Set ENCRYPTION_KEY or WEBHOOK_SECRET; the interactive installer generates both.
# Leave this blank to derive a key from WEBHOOK_SECRET. For a dedicated key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Language ----------------------------------------------
# Default output language for new users: "en" or "id".
DEFAULT_LANGUAGE=en

# ---- LLM ---------------------------------------------------
# Which LLM backend to use: "gemini", "openai", or "claude".
# Fill in only the section for the provider you choose below.
# TIP: an admin can also set the provider, model, and API keys from the bot with
#      /llm (stored encrypted) — then you can leave the values below blank.
# IMPORTANT: the embedding model must output 768-dim vectors (to match the DB).
LLM_PROVIDER=gemini
# Provider for embeddings (semantic search over memories, notes, files). Leave empty
# to use LLM_PROVIDER. Switching the chat provider in /llm never changes it; changing
# it here means existing data must be re-embedded. Its API key must be set too.
EMBEDDING_PROVIDER=
# Max seconds per LLM call before the bot gives up and asks the user to retry.
# Raise it if your provider is slow.
LLM_TIMEOUT_SECONDS=60

# ---- Google Gemini  (LLM_PROVIDER=gemini) ------------------
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- OpenAI-compatible  (LLM_PROVIDER=openai) --------------
# Works with OpenAI, Groq, OpenRouter, Together, DeepSeek, Mistral, LM Studio,
# and vLLM. Just point the base URL at your provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Anthropic Claude  (LLM_PROVIDER=claude) ---------------
# Chat and vision only: Claude has no embeddings API, so set EMBEDDING_PROVIDER
# (e.g. gemini, with its API key) when using Claude. Get a key at
# https://console.anthropic.com. Pick the model from the live list with /llm.
CLAUDE_API_KEY=
CLAUDE_CHAT_MODEL=claude-opus-5-5

# ---- Install method ----------------------------------------
# How PocketMemo was installed: "docker", "sqlite", or "native". Used by
# ./update.sh to know how to apply updates. The installer sets this for you.
INSTALL_METHOD=docker

# ---- Database ----------------------------------------------
# DOCKER install (PostgreSQL + pgvector): the DB_* parts below are assembled into
# DATABASE_URL by docker-compose — leave them as-is (just set a strong DB_PASSWORD).
DB_USER=pocketmemo
DB_PASSWORD=change-me
DB_NAME=pocketmemo
DB_HOST=db
DB_PORT=5432

# SQLITE install (ultra-light, no database server): comment out the DB_* lines
# above and use a single local file instead. Vector search runs in Python.
# DATABASE_URL=sqlite+aiosqlite:///./pocketmemo.db

# NATIVE install (your own PostgreSQL + pgvector, no Docker): comment out the DB_*
# lines above and point DATABASE_URL at your database.
# DATABASE_URL=postgresql+asyncpg://pocketmemo:password@localhost:5432/pocketmemo

# ---- Application -------------------------------------------
APP_PORT=8473
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
STORAGE_DIR=storage

# ---- Agent harness -----------------------------------------
# Bounded provider-agnostic tool loop. Set false to fall back to the legacy
# single-intent router. Tool access is allowlisted in pocketmemo/agent/tools.py.
AGENT_ENABLED=true
AGENT_MAX_STEPS=6
AGENT_TOOL_TIMEOUT_SECONDS=45

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone who messages the bot.
# Find your ID with @userinfobot.
ALLOWED_USER_IDS=
